# Local development defaults. Export these variables in your shell or deployment platform.
APP_ENV=development
FLASK_DEBUG=false
PORT=5000

# SQLite is the zero-setup local database. Production should use PostgreSQL.
DATABASE_URL=sqlite:///smart_seating.db

# Required when APP_ENV=production. Never commit a real secret.
SECRET_KEY=[REDACTED_SECRET]
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Exact comma-separated origins only. Leave empty for same-origin deployments.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false

# Deployment controls. Trust proxy headers only behind a trusted reverse proxy.
ALLOWED_HOSTS=localhost,127.0.0.1
TRUST_PROXY_HEADERS=false
RUN_MIGRATIONS=false
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
