# Copy to .env.production for Docker Compose. Never commit the populated file.
POSTGRES_DB=smart_seating
POSTGRES_USER=smart_seating
POSTGRES_PASSWORD=[REDACTED_SECRET]

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=[REDACTED_SECRET]
# One-time secret required to create the first institution administrator.
INITIAL_SETUP_TOKEN=[REDACTED_SECRET]
LOG_LEVEL=INFO

# Public DNS names only, comma-separated and without schemes or paths.
ALLOWED_HOSTS=seating.example.edu
HEALTHCHECK_HOST=seating.example.edu

# Use exact origins with schemes. Leave empty when UI and API share one origin.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
SESSION_COOKIE_SAMESITE=Lax

# Enable only when the container receives traffic exclusively through your proxy.
TRUST_PROXY_HEADERS=true
APP_PORT=8000
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
CELERY_CONCURRENCY=2
CELERY_MAX_TASKS_PER_CHILD=100
RATE_LIMIT_DEFAULT=300 per minute
# Shared Redis storage keeps limits consistent across web replicas.
RATE_LIMIT_STORAGE_URI=redis://redis:6379/2

# Optional thresholds. Smaller work remains synchronous.
BACKGROUND_IMPORT_MIN_BYTES=524288
BACKGROUND_IMPORT_COMMIT_MIN_ROWS=10000
BACKGROUND_OPTIMIZATION_MIN_STUDENTS=500
BACKGROUND_REPORT_MIN_ALLOCATIONS=1000

# For multi-host production, set JOB_STORAGE_BACKEND=s3 and configure these
# values in the platform secret manager instead of this example file.
# S3_BUCKET=seatplan-private-artifacts
# S3_PREFIX=seatplan-jobs
# S3_ENDPOINT_URL=https://s3-compatible.example.edu
# S3_REGION=ap-south-1
