# Copy to .env.production for Docker Compose. Never commit the populated file.
POSTGRES_DB=smart_seating
POSTGRES_USER=smart_seating
POSTGRES_PASSWORD=[REDACTED_SECRET]

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=[REDACTED_SECRET]
LOG_LEVEL=INFO

# Public DNS names only, comma-separated and without schemes or paths.
ALLOWED_HOSTS=seating.example.edu
HEALTHCHECK_HOST=seating.example.edu

# Use exact origins with schemes. Leave empty when UI and API share one origin.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
SESSION_COOKIE_SAMESITE=Lax

# Enable only when the container receives traffic exclusively through your proxy.
TRUST_PROXY_HEADERS=true
APP_PORT=8000
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
